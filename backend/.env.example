# Copy to backend/.env to override defaults. All variables are optional.
LH_DATABASE_URL=postgresql+psycopg://learninghub:learninghub@localhost:5434/learninghub
# LH_ROADMAPS_DIR=../roadmaps
# LH_STORAGE_DIR=../storage
# LH_MAX_UPLOAD_BYTES=10485760

# Agent providers (optional). Easiest: add providers in the app's Settings page.
# Values here are imported ONCE at startup as "<Type> (from .env)" configurations.
# LH_ANTHROPIC_API_KEY=
# LH_OPENAI_API_KEY=
# LH_DEEPSEEK_API_KEY=
# LH_OLLAMA_URL=http://localhost:11434
# LH_AGENT_MAX_STEPS=6
# LH_AGENT_RATE_PER_MINUTE=20
# Encrypts keys saved in the app (any passphrase); default: storage/secret.key
# LH_SECRET_KEY=

# Owner login (off until the app turns it on). Links in emails and OAuth redirects use LH_PUBLIC_URL.
# LH_AUTH_REQUIRED=false
# LH_PUBLIC_URL=http://localhost:5173
# GitHub / Google OAuth apps; callback: <LH_PUBLIC_URL>/api/auth/oauth/<github|google>/callback
# LH_GITHUB_CLIENT_ID=
# LH_GITHUB_CLIENT_SECRET=
# LH_GOOGLE_CLIENT_ID=
# LH_GOOGLE_CLIENT_SECRET=
# Email over SMTP (STARTTLS on 587, SSL on 465); without a host, mail goes to storage/outbox/*.eml
# LH_SMTP_HOST=
# LH_SMTP_PORT=587
# LH_SMTP_USER=
# LH_SMTP_PASSWORD=
# LH_SMTP_FROM=
