# Copy to backend/.env to override defaults. All variables are optional.
LH_DATABASE_URL=postgresql+psycopg://learninghub:learninghub@localhost:5434/learninghub
# LH_ROADMAPS_DIR=../roadmaps
# LH_STORAGE_DIR=../storage
# LH_MAX_UPLOAD_BYTES=10485760

# Agent providers (optional). Easiest: paste a key in the app's Settings page instead.
# Keys here need a backend restart; a key saved in the app overrides the one here.
# LH_ANTHROPIC_API_KEY=
# LH_OPENAI_API_KEY=
# LH_DEEPSEEK_API_KEY=
# LH_OLLAMA_URL=http://localhost:11434
# LH_AGENT_MAX_STEPS=6
# LH_AGENT_RATE_PER_MINUTE=20
# Encrypts keys saved in the app (any passphrase); default: storage/secret.key
# LH_SECRET_KEY=
